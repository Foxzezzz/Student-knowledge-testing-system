<Window x:Class="KnowledgeTesting.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система тестирования знаний" Height="540" Width="760" MinHeight="480" MinWidth="620"
        Background="#F5F7FB">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Проверка знаний" FontSize="26" FontWeight="SemiBold" Foreground="#192C48" />
            <TextBlock Text="Демонстрационный тест по основам C#" Margin="0,4,0,0" Foreground="#52647A" />
        </StackPanel>
        <TextBlock x:Name="ProgressText" Grid.Row="1" Margin="0,24,0,8" Foreground="#52647A" FontWeight="SemiBold" />
        <Border Grid.Row="2" Background="White" BorderBrush="#D9E0EA" BorderThickness="1" CornerRadius="8" Padding="20">
            <DockPanel>
                <TextBlock x:Name="QuestionText" DockPanel.Dock="Top" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16" />
                <ListBox x:Name="OptionsList" BorderThickness="0" FontSize="15" />
            </DockPanel>
        </Border>
        <TextBlock x:Name="ResultText" Grid.Row="3" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="#1D6849" FontWeight="SemiBold" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,18,0,0">
            <Button x:Name="AnswerButton" Content="Ответить" Click="AnswerButton_Click" Padding="18,7" Margin="0,0,10,0" />
            <Button Content="Начать заново" Click="RestartButton_Click" Padding="18,7" />
        </StackPanel>
    </Grid>
</Window>
